<?xml version="1.0"?>
<Container version="2">
  <Name>mealiev1</Name>
  <Repository>ghcr.io/mealie-recipes/mealie:v3.29.0</Repository>
  <Registry>https://github.com/mealie-recipes/mealie/pkgs/container/mealie</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/138058-support-catduck-templates/</Support>
  <Project>https://mealie.io/</Project>
  <Overview>Mealie is a self-hosted recipe manager and meal planner with a REST API backend and a reactive frontend application.

This template keeps the container name and appdata directory as mealiev1, and maps host port 3000 to Mealie's container port 9000 by default, preserving existing install settings. Mealie listens on container port 9000.

SMTP settings are optional. Configure them only if you want Mealie to send email. SQLite is the default database; PostgreSQL settings are available under advanced options.</Overview>
  <Category>Productivity:</Category>
  <WebUI>http://[IP]:[PORT:9000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/catduckgnaf/catduck-unraid-templates/main/templates/mealie.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/catduckgnaf/catduck-unraid-templates/main/templates/img/mealiev1.png</Icon>
  <Config Name="Port" Target="9000" Default="" Mode="tcp" Description="Host port for the Mealie web interface" Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="App Data" Target="/app/data" Default="/mnt/user/appdata/mealiev1" Mode="rw" Description="Persistent Mealie application data" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/mealiev1</Config>
  <Config Name="ALLOW_SIGNUP" Target="ALLOW_SIGNUP" Default="" Mode="" Description="Allow new user registration" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
  <Config Name="DEFAULT_EMAIL" Target="DEFAULT_EMAIL" Default="" Mode="" Description="Optional default email address" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="SMTP_FROM_EMAIL" Target="SMTP_FROM_EMAIL" Default="" Mode="" Description="Email address used as the sender for outgoing email" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="SMTP_HOST" Target="SMTP_HOST" Default="" Mode="" Description="SMTP server hostname" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="SMTP_USER" Target="SMTP_USER" Default="" Mode="" Description="SMTP username" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="SMTP_PASSWORD" Target="SMTP_PASSWORD" Default="" Mode="" Description="SMTP password or app password" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="SMTP_PORT" Target="SMTP_PORT" Default="" Mode="" Description="SMTP server port" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="BASE_URL" Target="BASE_URL" Default="" Mode="" Description="External URL if using a reverse proxy" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="DEFAULT_GROUP" Target="DEFAULT_GROUP" Default="home" Mode="" Description="Default group for new users" Type="Variable" Display="advanced" Required="false" Mask="false">home</Config>
  <Config Name="PUID" Target="PUID" Default="" Mode="" Description="User ID" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="" Mode="" Description="Group ID" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="WEB_CONCURRENCY" Target="WEB_CONCURRENCY" Default="" Mode="" Description="Web worker concurrency" Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
  <Config Name="MAX_WORKERS" Target="MAX_WORKERS" Default="" Mode="" Description="Maximum background workers" Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
  <Config Name="DB_ENGINE" Target="DB_ENGINE" Default="" Mode="" Description="Database engine: sqlite or postgres" Type="Variable" Display="advanced" Required="false" Mask="false">sqlite</Config>
  <Config Name="POSTGRES_USER" Target="POSTGRES_USER" Default="" Mode="" Description="PostgreSQL username" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="POSTGRES_PASSWORD" Target="POSTGRES_PASSWORD" Default="" Mode="" Description="PostgreSQL password" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="POSTGRES_SERVER" Target="POSTGRES_SERVER" Default="" Mode="" Description="PostgreSQL server" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="POSTGRES_PORT" Target="POSTGRES_PORT" Default="" Mode="" Description="PostgreSQL port" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="POSTGRES_DB" Target="POSTGRES_DB" Default="" Mode="" Description="PostgreSQL database name" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
</Container>
